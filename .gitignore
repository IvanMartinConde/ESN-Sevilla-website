# Credenciales y archivos sensibles de Drupal
sites/*/settings.php
sites/*/settings.local.php
sites/*/services.yml
sites/*/services.local.yml

# Archivos pesados subidos por usuarios (fotos de eventos, PDFs)
sites/*/files/

# Carpetas secundarias del servidor que no son la web principal
wiki/
wp-content/
wp-includes/
wp-admin/
dev/
testing.esnsevilla.org/
repositorio/

# Dependencias generadas
vendor/

# Archivos de copia de seguridad y volcados de bases de datos
*.sql
*.sql.gz
*.tar.gz
*.zip

# Basura del sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/